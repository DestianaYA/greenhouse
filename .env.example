# Copy to .env and adjust. (Docker Compose sets its own values for the app container.)
APP_NAME=Greenhouse Backend
LOG_LEVEL=INFO

# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://greenhouse:greenhouse_pass@127.0.0.1:3306/greenhouse
# SQLite alternative (zero setup):
# DATABASE_URL=sqlite:///./greenhouse.db

# --- MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CONTROL_TOPIC_PREFIX=greenhouse/control
MQTT_CONTROL_QOS=1
MQTT_CONTROL_RETAIN=true
MQTT_PUBLISH_TIMEOUT=3
# Also accept sensor readings published to greenhouse/sensor/{sensor_id}
MQTT_SUBSCRIBE_SENSORS=true
MQTT_SENSOR_TOPIC_PREFIX=greenhouse/sensor

# --- Security ---
# If set, POST /device-control requires header: X-API-Key: <value>
API_KEY=
